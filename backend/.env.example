# Anthropic — leave blank to run in STUB mode (no real LLM calls).
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model selection. Production target is claude-opus-4-7 for accuracy,
# claude-sonnet-4-6 for cost, claude-haiku-4-5 for latency. See CURSOR-HANDOFF.md
# §"Open questions" — affects everything downstream.
ANTHROPIC_MODEL=claude-sonnet-4-6

PORT=3001
# Remote hosts allowed to call the API. Loopback origins are accepted on any
# port outside production, so there is no need to list local ports here — the
# ones below are only kept for separate front-end dev servers.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Set to "1" to force stub responses even if ANTHROPIC_API_KEY is present.
# Useful when running the eval lab as a pure demo.
FORCE_STUB=0

# World Labs (Marble) World API — powers the /synthetic-pov splat panel via
# the server-side /api/worldlabs/* proxy. Leave blank to disable the panel's
# "Generate" controls. Get a key at https://platform.worldlabs.ai/api-keys
# NOTE: world generation consumes credits and takes ~minutes per world.
WORLDLABS_API_KEY=
WORLDLABS_MODEL=marble-1.1

# Reshim analysis (tools/reshim). The agent needs Python + the MSSQL ODBC
# driver + the plant network, so hosts without them disable "Run now" and rely
# on the reshim-daily workflow publishing results instead.
#
# Interpreter used for the on-demand run. A venv path works here.
RESHIM_PYTHON=python3
# Where run folders live. Defaults to shared/data/reshim-runs inside the repo;
# the cloud deploy points this at a mounted disk so deploys don't wipe history.
RESHIM_RUN_ROOT=
# Shared secret the daily workflow presents to POST /api/reshim/runs. That
# endpoint writes to disk, so leaving this blank keeps it closed (503).
RESHIM_INGEST_TOKEN=

# Outbound mail over Microsoft Graph, app-only. Same names the Python agent
# reads (tools/reshim/config.py), so one set of values serves both. Without
# them the dashboard's "Also email" is disabled and explains why.
#
# App registration needs the Mail.Send *application* permission with admin
# consent; the secret is the client secret's value, not its id.
MSAL_TENANT_ID=
MSAL_CLIENT_ID=
MSAL_CLIENT_SECRET=
# Mailbox the report is sent as. Must exist in the tenant.
MAIL_FROM=
MAIL_REPLY_TO=
# Comma-separated standing distribution list. This is also who a [SAMPLE] send
# from the dashboard reaches, so keep it to people who should see one.
MAIL_RECIPIENTS=
